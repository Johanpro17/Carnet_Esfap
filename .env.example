# ============================================
# Plantilla de configuracion - copia este archivo como ".env" y ajusta los valores.
# Tambien puedes definir estas variables en el entorno del servidor (tienen prioridad).
# ============================================

# --- Base de datos ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=carnet_esfap_v2
DB_USERNAME=root
DB_PASSWORD=
# true: si la base de datos o sus tablas no existen, se crean e importan automaticamente al primer arranque.
DB_AUTO_SETUP=true

# --- Aplicacion ---
# true muestra el detalle de errores (solo desarrollo). En produccion usar false.
APP_DEBUG=false

# URL publica (con http/https) que se incrusta en los codigos QR.
# Ej.: https://carnets.mi-esfap.edu.pe
# Dejala vacia para que el sistema use el host de la peticion automaticamente.
QR_BASE_URL=
