# Configuración local con credenciales (NO subir al repositorio)
.env
*.local

# Fotos de alumnos y archivos subidos en tiempo de ejecución
# Se conserva uploads/index.html para que la carpeta exista y no se liste su contenido.
/public/uploads/*
!/public/uploads/index.html

# Material de referencia / diseño (no forma parte de la app)
/Modelo Carnet/

# Logs y temporales
*.log
*.tmp

# Sistema operativo / editores
.DS_Store
Thumbs.db
Thumbs.db:encryptable
desktop.ini
.idea/
.vscode/
*.swp
